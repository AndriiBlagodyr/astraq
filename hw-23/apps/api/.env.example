# Copy to apps/api/.env.local (gitignored). The api server needs none of
# these locally; the defaults in src/common/local-defaults.ts match
# `pnpm infra:up`.

# Market data bootstrap (`pnpm --filter @astraq/api bootstrap`).
# Free keys: https://app.alpaca.markets -> API Keys (paper account keys work).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional: `sip` (default, all US exchanges) or `iex`.
# ALPACA_FEED=sip
