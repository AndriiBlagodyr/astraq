{
  "name": "@astraq/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build": "nest build",
    "dev": "(prisma migrate deploy || echo Migrations not applied, see the error above. Starting anyway.) && nest start --watch",
    "start": "node dist/main",
    "start:debug": "nest start --debug --watch",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "openapi:emit": "nest build && node dist/openapi/emit",
    "bootstrap": "nest build && node --env-file-if-exists=.env.local dist/market-data/bootstrap/main",
    "lint": "eslint src eslint.config.mjs vitest.config.ts vitest.integration.config.ts prisma.config.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@astraq/shared": "workspace:*",
    "@nestjs/common": "^11.1.24",
    "@nestjs/core": "^11.1.24",
    "@nestjs/platform-express": "^11.1.24",
    "@nestjs/swagger": "^11.4.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "cors": "^2.8.5",
    "express": "^4.21.0",
    "nestjs-pino": "^4.6.1",
    "nestjs-zod": "^5.5.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^7.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/testing": "^11.1.24",
    "@swc/core": "^1.15.40",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.39",
    "@types/supertest": "^7.2.0",
    "eslint": "^9.39.4",
    "globals": "^17.11.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.2.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.68.0",
    "unplugin-swc": "^1.5.9",
    "vitest": "^4.1.4"
  }
}