    "/api/symbols/{ticker}/candles": {
      "get": {
        "operationId": "getDailyCandles",
        "parameters": [
          {
            "name": "ticker",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,15}$",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          },
          {
            "name": "adjustment",
            "required": false,
            "in": "query",
            "schema": {
              "default": "split",
              "$ref": "#/components/schemas/Adjustment"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleSeries_Output"
                }
              }
            }
          },
          "default": {
            "description": "Any error, as an RFC 9457 problem detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem_Output"
                }
              }
            }
          }
        },
        "summary": "Daily candles, adjusted for splits (and dividends) on request",
        "tags": [
          "symbols"
        ]
      }
    },
