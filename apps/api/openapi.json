    "/api/symbols": {
      "get": {
        "operationId": "searchSymbols",
        "parameters": [
          {
            "name": "query",
            "required": false,
            "in": "query",
            "schema": {
              "maxLength": 64,
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SymbolList_Output"
                }
              }
            }
          },
          "default": {
            "description": "Any error, as an RFC 9457 problem detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem_Output"
                }
              }
            }
          }
        },
        "summary": "Find symbols by ticker prefix or name",
        "tags": [
          "symbols"
        ]
      }
    },
    "/api/symbols/{ticker}/candles": {
      "get": {
        "operationId": "getDailyCandles",
        "parameters": [
          {
            "name": "ticker",
            "required": true,
            "in": "path",
            "schema": {
              "pattern": "^[A-Za-z][A-Za-z0-9.-]{0,15}$",
              "type": "string"
            }
          },
          {
            "name": "from",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          },
          {
            "name": "to",
            "required": false,
            "in": "query",
            "schema": {
              "format": "date",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
              "type": "string"
            }
          },
          {
            "name": "adjustment",
            "required": false,
            "in": "query",
            "schema": {
              "default": "split",
              "$ref": "#/components/schemas/Adjustment"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CandleSeries_Output"
                }
              }
            }
          },
          "default": {
            "description": "Any error, as an RFC 9457 problem detail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem_Output"
                }
              }
            }
          }
        },
        "summary": "Daily candles, adjusted for splits (and dividends) on request",
        "tags": [
          "symbols"
        ]
      }
    }
  },
  "info": {
    "title": "Veracand API",
    "description": "Domain API for Veracand. The web app calls it through @astraq/sdk, generated from this document.",
    "version": "0.1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "Problem_Output": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
          },
          "errors": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "path": {
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "string"
                      },
                      {
                        "type": "number"
                      }
                    ]
                  }
                },
                "message": {
                  "type": "string"
                }
              },
              "required": [
                "path",
                "message"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "timestamp"
        ],
        "additionalProperties": false
      },
      "RegisterBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthTokens_Output": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ],
        "additionalProperties": false
      },
      "LoginBody": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 254,
            "format": "email",
            "pattern": "^(?!\\.)(?!.*\\.\\.)([A-Za-z0-9_'+\\-\\.]*)[A-Za-z0-9_+-]@([A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
          },
          "password": {
            "type": "string",
            "minLength": 12,
            "maxLength": 128
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "RefreshBody": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "HealthStatus_Output": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "const": "ok"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "The git commit the running build came from, or null outside a deploy."
          }
        },
        "required": [
          "status",
          "version"
        ],
        "additionalProperties": false
      },
      "SymbolSummary_Output": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "exchange": {
            "type": "string"
          },
          "latestClose": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/LatestClose_Output"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "ticker",
          "name",
          "exchange",
          "latestClose"
        ],
        "additionalProperties": false
      },
      "LatestClose_Output": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "close": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "previousClose": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^\\d+(\\.\\d+)?$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "date",
          "close",
          "previousClose"
        ],
        "additionalProperties": false
      },
      "SymbolList_Output": {
        "type": "object",
        "properties": {
          "symbols": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SymbolSummary_Output"
            }
          }
        },
        "required": [
          "symbols"
        ],
        "additionalProperties": false
      },
      "Adjustment_Output": {
        "type": "string",
        "enum": [
          "raw",
          "split",
          "all"
        ]
      },
      "Candle_Output": {
        "type": "object",
        "properties": {
          "time": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "open": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "high": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "low": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "close": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "volume": {
            "type": "string",
            "pattern": "^\\d+$"
          }
        },
        "required": [
          "time",
          "open",
          "high",
          "low",
          "close",
          "volume"
        ],
        "additionalProperties": false
      },
      "Split_Output": {
        "type": "object",
        "properties": {
          "exDate": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "from": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          },
          "to": {
            "type": "string",
            "pattern": "^\\d+(\\.\\d+)?$"
          }
        },
        "required": [
          "exDate",
          "from",
          "to"
        ],
        "additionalProperties": false
      },
      "CandleSeries_Output": {
        "type": "object",
        "properties": {
          "ticker": {
            "type": "string"
          },
          "adjustment": {
            "$ref": "#/components/schemas/Adjustment_Output"
          },
          "candles": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Candle_Output"
            }
          },
          "splits": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Split_Output"
            }
          }
        },
        "required": [
          "ticker",
          "adjustment",
          "candles",
          "splits"
        ],
        "additionalProperties": false
      },
      "Adjustment": {
        "type": "string",
        "enum": [
          "raw",
          "split",
          "all"
        ]
      }
    }
  }
}
