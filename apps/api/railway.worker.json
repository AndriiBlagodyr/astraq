{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/api/Dockerfile",
    "watchPatterns": [
      "apps/api/**",
      "packages/shared/**",
      "pnpm-lock.yaml",
      ".dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "node dist/market-data/jobs/worker.main",
    "restartPolicyType": "ALWAYS"
  }
}
