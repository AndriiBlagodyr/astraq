# Copy to apps/api/.env.local (gitignored). The api server needs none of
# these locally; the defaults in src/common/local-defaults.ts match
# `pnpm infra:up`.

# Market data loaders (`pnpm --filter @astraq/api symbols:sync`, `bootstrap`)
# require these. The api server reads them too, optionally: with keys a
# newly watched symbol gets its candles loaded on the spot, without them it
# serves what's stored. Free keys: https://app.alpaca.markets -> API Keys
# (paper account keys work).
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
# Optional: `sip` (default, all US exchanges) or `iex`.
# ALPACA_FEED=sip
# Optional: the trading API host for the asset list. Live keys need
# https://api.alpaca.markets; paper keys use the default.
# ALPACA_TRADING_URL=https://paper-api.alpaca.markets
