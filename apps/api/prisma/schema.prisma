// The api's Postgres schema. Prisma Migrate owns every change to it; see
// apps/api/AGENTS.md. TimescaleDB DDL (the extension, hypertables) and CHECK
// constraints can't be expressed here, so they live in hand-edited
// migrations made with `prisma migrate dev --create-only`.
//
// Conventions: tables and columns are snake_case (`@@map` / `@map`), money
// and prices are fixed-precision `numeric`, timestamps are `timestamptz`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A tradable instrument, keyed by its exchange ticker.
model Symbol {
  id        Int      @id @default(autoincrement())
  ticker    String   @unique @db.VarChar(16)
  name      String
  /// MIC-style exchange code, e.g. XNAS, XNYS.
  exchange  String   @db.VarChar(16)
  /// Inactive symbols keep their history but are skipped by ingestion.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  candlesDaily     CandleDaily[]
  corporateActions CorporateAction[]
  watchlistItems   WatchlistItem[]
  ledgerEntries    LedgerEntry[]
  orders           Order[]

  @@map("symbols")
}

/// One raw (unadjusted) daily bar. A TimescaleDB hypertable partitioned on
/// `ts`. Adjusted prices are computed at read time from `corporate_actions`.
model CandleDaily {
  symbolId Int      @map("symbol_id")
  /// The session date at 00:00 UTC.
  ts       DateTime @db.Timestamptz(6)
  open     Decimal  @db.Decimal(18, 6)
  high     Decimal  @db.Decimal(18, 6)
  low      Decimal  @db.Decimal(18, 6)
  close    Decimal  @db.Decimal(18, 6)
  volume   BigInt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  // Hypertable unique keys must include the partition column (`ts`). Leading
  // with symbol_id serves "one symbol over a date range", the main read.
  @@id([symbolId, ts])
  @@map("candles_daily")
}

enum CorporateActionType {
  SPLIT    @map("split")
  DIVIDEND @map("dividend")

  @@map("corporate_action_type")
}

/// One trading day of the US equity market, from the exchange calendar
/// (ROADMAP Phase 3 item 5). A weekday without a row, between the first
/// and the last date stored, is a holiday; a half day closes early.
model MarketSession {
  /// The session's New York calendar date, as a daily bar names it.
  date     DateTime @id @db.Date
  opensAt  DateTime @map("opens_at") @db.Timestamptz(6)
  closesAt DateTime @map("closes_at") @db.Timestamptz(6)

  @@map("market_sessions")
}

/// A split or cash dividend, effective on its ex-date. Which columns are set
/// depends on `type`; a CHECK constraint in the migration enforces it.
model CorporateAction {
  id         Int                 @id @default(autoincrement())
  symbolId   Int                 @map("symbol_id")
  type       CorporateActionType
  exDate     DateTime            @map("ex_date") @db.Date
  /// Split: `split_from` old shares became `split_to` new ones
  /// (NVDA 2024: from 1, to 10). A reverse split has from > to.
  splitFrom  Decimal?            @map("split_from") @db.Decimal(18, 6)
  splitTo    Decimal?            @map("split_to") @db.Decimal(18, 6)
  /// Dividend: cash paid per share, in the listing currency.
  cashAmount Decimal?            @map("cash_amount") @db.Decimal(18, 6)
  /// Dividend: the day the cash is paid. Null on a split, and on a dividend
  /// the provider gave no pay date for (it is then paid on the ex-date).
  payDate    DateTime?           @map("pay_date") @db.Date
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  // Also the natural key the bootstrap CLI upserts on.
  @@unique([symbolId, type, exDate])
  @@map("corporate_actions")
}

/// A person who can sign in. Registration is invite-only until Phase 7 (an
/// env allowlist of emails; see ADR 0006).
model User {
  /// UUIDv7: time-ordered like a serial, but doesn't reveal how many users
  /// exist when it shows up in a token or a URL.
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased; a CHECK constraint in the migration
  /// rejects anything else, so uniqueness is case-insensitive.
  email        String   @unique @db.VarChar(254)
  /// A display name for the user menu; null until set. Trimmed and one
  /// line, enforced by a CHECK constraint in the migration.
  name         String?  @db.VarChar(80)
  /// Argon2id in PHC string format (`$argon2id$v=19$m=...`), parameters
  /// included, so they can be raised later without a migration.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions   Session[]
  auditLogs  AuditLog[]
  watchlists Watchlist[]
  portfolios Portfolio[]

  @@map("users")
}

enum SessionRevokedReason {
  /// The user signed out on this device.
  LOGOUT         @map("logout")
  /// The user chose "log out everywhere".
  LOGOUT_ALL     @map("logout_all")
  /// A rotated refresh token came back: the family is assumed stolen.
  REUSE_DETECTED @map("reuse_detected")

  @@map("session_revoked_reason")
}

/// One signed-in device: a refresh-token family. Every token rotated from
/// the login's first one belongs to the same session, and revoking the
/// session revokes them all (ADR 0006).
model Session {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  /// Absolute end of the family. Rotation never extends it, so a stolen
  /// family dies on schedule even if it keeps refreshing.
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokedReason? @map("revoked_reason")
  /// Recorded at login, for a future "your devices" list. Not trusted for
  /// any decision.
  userAgent     String?               @map("user_agent") @db.VarChar(512)
  ip            String?               @db.Inet
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // "Log out everywhere" revokes a user's live sessions.
  @@index([userId])
  @@map("sessions")
}

/// One opaque refresh token. Only its SHA-256 hash is stored: the token is
/// 256 random bits, so a fast hash is enough, and a database leak yields
/// nothing usable.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash") @db.ByteA
  /// The token this one was rotated from: null for the login's first token,
  /// and once the parent is pruned.
  parentId  String?   @map("parent_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when the token is exchanged. Presenting it again after the grace
  /// window is reuse, and revokes the session.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("RefreshTokenRotation", fields: [parentId], references: [id], onDelete: SetNull)
  children RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([parentId])
  @@map("refresh_tokens")
}

enum AuditAction {
  REGISTER        @map("register")
  LOGIN_SUCCEEDED @map("login_succeeded")
  LOGIN_FAILED    @map("login_failed")
  REFRESH_REUSED  @map("refresh_reused")
  LOGOUT          @map("logout")
  LOGOUT_ALL      @map("logout_all")

  @@map("audit_action")
}

/// Append-only record of security events. The repository only inserts.
model AuditLog {
  id        BigInt      @id @default(autoincrement())
  /// Null when the event has no known user, e.g. a login with an unknown
  /// email. Kept (set null) if the user is ever deleted.
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ip        String?     @db.Inet
  userAgent String?     @map("user_agent") @db.VarChar(512)
  /// Event-specific details, e.g. the session id. Never a password or token.
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // A user's history, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// A user's named group of symbols. Every read and write is scoped by
/// `user_id` in the repository, so one user never sees another's lists.
model Watchlist {
  id        String   @id @default(uuid(7)) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  /// Trimmed, one line; unique per user so a rename can't shadow a list.
  name      String   @db.VarChar(64)
  /// The list's place among the user's lists, 0-based. Gaps are fine.
  position  Int
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  items WatchlistItem[]

  @@unique([userId, name])
  @@index([userId, position])
  @@map("watchlists")
}

/// A symbol on a watchlist. A symbol appears on a list at most once.
model WatchlistItem {
  watchlistId String   @map("watchlist_id") @db.Uuid
  symbolId    Int      @map("symbol_id")
  /// The row's place on the list, 0-based. Reordering rewrites every row's
  /// position in one transaction, so gaps and ties can't last.
  position    Int
  addedAt     DateTime @default(now()) @map("added_at") @db.Timestamptz(6)

  watchlist Watchlist @relation(fields: [watchlistId], references: [id], onDelete: Cascade)
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  @@id([watchlistId, symbolId])
  @@index([watchlistId, position])
  @@map("watchlist_items")
}

/// A paper-trading account. Its cash and positions are never stored: they
/// are derived from its ledger (ADR 0009). The cost columns are the fill
/// model's per-portfolio settings (ADR 0008).
model Portfolio {
  id                 String   @id @default(uuid(7)) @db.Uuid
  userId             String   @map("user_id") @db.Uuid
  /// Trimmed, one line; unique per user.
  name               String   @db.VarChar(64)
  /// Slippage on market-priced fills, in basis points.
  slippageBps        Int      @default(0) @map("slippage_bps")
  commissionPerOrder Decimal  @default(0) @map("commission_per_order") @db.Decimal(18, 2)
  commissionPerShare Decimal  @default(0) @map("commission_per_share") @db.Decimal(18, 6)
  /// The most one order may come to, before commission; null for no limit.
  maxOrderNotional   Decimal? @map("max_order_notional") @db.Decimal(18, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user               User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  ledgerTransactions LedgerTransaction[]
  orders             Order[]

  @@unique([userId, name])
  @@map("portfolios")
}

enum LedgerTransactionKind {
  DEPOSIT          @map("deposit")
  WITHDRAWAL       @map("withdrawal")
  BUY              @map("buy")
  SELL             @map("sell")
  /// A split changed the share count of open lots; their cost is unchanged.
  SPLIT            @map("split")
  /// A dividend went ex: the cash is owed to the portfolio from this day.
  DIVIDEND         @map("dividend")
  /// The owed dividend arrived in cash on its pay date.
  DIVIDEND_PAYMENT @map("dividend_payment")

  @@map("ledger_transaction_kind")
}

/// One event in a portfolio's books: a deposit, a fill. Its entries sum to
/// zero, checked by a constraint trigger at commit. Rows are never updated,
/// and deleted only together with their portfolio (triggers in the
/// migration).
model LedgerTransaction {
  id          String                @id @default(uuid(7)) @db.Uuid
  portfolioId String                @map("portfolio_id") @db.Uuid
  /// The transaction's place in the portfolio's history, from 1, without
  /// gaps. Replaying in this order rebuilds every balance and lot.
  seq         Int
  kind        LedgerTransactionKind
  /// When the event took effect (a fill's time), not when the row was written.
  occurredAt  DateTime              @map("occurred_at") @db.Timestamptz(6)
  /// Set on a split and only there (CHECK constraint in the migration):
  /// `split_from` old shares became `split_to` new ones. Replay needs the
  /// ratio to redo the split lot by lot.
  splitFrom   Decimal?              @map("split_from") @db.Decimal(18, 6)
  splitTo     Decimal?              @map("split_to") @db.Decimal(18, 6)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  portfolio Portfolio     @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  entries   LedgerEntry[]
  fill      Fill?

  @@unique([portfolioId, seq])
  @@map("ledger_transactions")
}

enum LedgerAccount {
  /// Asset: cash in the portfolio.
  CASH                 @map("cash")
  /// Asset: shares held, at cost.
  SECURITIES           @map("securities")
  /// Equity: what the owner paid in, less what they took out.
  CAPITAL              @map("capital")
  /// Expense: commissions.
  FEES                 @map("fees")
  /// Income: gains (credits) and losses (debits) on closed lots.
  REALIZED_PNL         @map("realized_pnl")
  /// Asset: dividends that have gone ex and aren't paid yet.
  DIVIDENDS_RECEIVABLE @map("dividends_receivable")
  /// Income: dividends earned, booked on the ex-date.
  DIVIDEND_INCOME      @map("dividend_income")

  @@map("ledger_account")
}

/// One leg of a transaction: an amount moved into (positive, a debit) or
/// out of (negative, a credit) an account.
model LedgerEntry {
  id            BigInt        @id @default(autoincrement())
  transactionId String        @map("transaction_id") @db.Uuid
  account       LedgerAccount
  /// Set on securities, realized_pnl, and both dividend accounts, null on
  /// the others (CHECK constraint in the migration).
  symbolId      Int?          @map("symbol_id")
  /// In cents. Debits are positive, credits negative.
  amount        Decimal       @db.Decimal(20, 2)
  /// Shares bought (positive) or sold (negative); zero off the securities
  /// account.
  quantity      Decimal       @default(0) @db.Decimal(24, 6)

  transaction LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  /// A symbol with ledger history is deactivated, never deleted.
  symbol      Symbol?           @relation(fields: [symbolId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([symbolId])
  @@map("ledger_entries")
}

enum OrderSide {
  BUY  @map("buy")
  SELL @map("sell")

  @@map("order_side")
}

enum OrderType {
  MARKET @map("market")
  LIMIT  @map("limit")

  @@map("order_type")
}

enum OrderStatus {
  /// Waiting for a session that fills it.
  OPEN      @map("open")
  FILLED    @map("filled")
  CANCELLED @map("cancelled")
  /// It met a fill and the ledger refused it.
  REJECTED  @map("rejected")

  @@map("order_status")
}

/// Why an order ended without a fill.
enum OrderCloseReason {
  /// Cancelled by its owner.
  USER                @map("user")
  /// Cancelled because the symbol split while the order was waiting: its
  /// quantity and limit were in the old shares.
  SPLIT               @map("split")
  INSUFFICIENT_CASH   @map("insufficient_cash")
  INSUFFICIENT_SHARES @map("insufficient_shares")
  /// The fill came to less than a cent.
  TOO_SMALL           @map("too_small")

  @@map("order_close_reason")
}

/// An instruction to buy or sell in a paper portfolio (ADR 0009 section 7).
/// It fills whole or not at all (ADR 0008), so it has at most one fill.
model Order {
  id             String            @id @default(uuid(7)) @db.Uuid
  portfolioId    String            @map("portfolio_id") @db.Uuid
  symbolId       Int               @map("symbol_id")
  side           OrderSide
  type           OrderType
  /// Shares, above zero.
  quantity       Decimal           @db.Decimal(24, 6)
  /// Set on a limit order and only there (CHECK constraint in the migration).
  limitPrice     Decimal?          @map("limit_price") @db.Decimal(18, 6)
  status         OrderStatus       @default(OPEN)
  /// Set when the order was cancelled or rejected.
  closeReason    OrderCloseReason? @map("close_reason")
  /// The client's key for this placement: sending it again returns this
  /// order instead of placing a second one.
  idempotencyKey String            @map("idempotency_key") @db.VarChar(128)
  /// When the api accepted the order. Decides which session it may first
  /// fill in: only one that opened after this instant.
  placedAt       DateTime          @map("placed_at") @db.Timestamptz(6)
  /// When it filled, was cancelled, or was rejected; null while open.
  closedAt       DateTime?         @map("closed_at") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  portfolio Portfolio @relation(fields: [portfolioId], references: [id], onDelete: Cascade)
  /// A symbol with orders is deactivated, never deleted.
  symbol    Symbol    @relation(fields: [symbolId], references: [id], onDelete: Restrict)
  fill      Fill?

  @@unique([portfolioId, idempotencyKey])
  // A portfolio's orders newest first, and its open ones for settlement.
  @@index([portfolioId, placedAt(sort: Desc)])
  @@index([portfolioId, status])
  @@map("orders")
}

/// Which fill-model rule priced a fill (ADR 0008).
enum FillRule {
  MARKET_OPEN @map("market_open")
  MARKET_LAST @map("market_last")
  LIMIT_OPEN  @map("limit_open")
  LIMIT_CROSS @map("limit_cross")

  @@map("fill_rule")
}

/// An order's fill: what the fill model decided, and the ledger transaction
/// that booked it. Written once, in the same database transaction as that
/// ledger transaction and the order's status.
model Fill {
  id                  String   @id @default(uuid(7)) @db.Uuid
  orderId             String   @unique @map("order_id") @db.Uuid
  ledgerTransactionId String   @unique @map("ledger_transaction_id") @db.Uuid
  rule                FillRule
  /// Per share.
  price               Decimal  @db.Decimal(18, 6)
  quantity            Decimal  @db.Decimal(24, 6)
  /// `quantity × price` in cents; never includes the commission.
  notional            Decimal  @db.Decimal(20, 2)
  commission          Decimal  @db.Decimal(20, 2)
  /// The session whose bar priced the fill.
  sessionDate         DateTime @map("session_date") @db.Date
  filledAt            DateTime @map("filled_at") @db.Timestamptz(6)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  order             Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ledgerTransaction LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Cascade)

  @@map("fills")
}
