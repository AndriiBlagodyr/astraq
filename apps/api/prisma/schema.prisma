// The api's Postgres schema. Prisma Migrate owns every change to it; see
// apps/api/AGENTS.md. TimescaleDB DDL (the extension, hypertables) and CHECK
// constraints can't be expressed here, so they live in hand-edited
// migrations made with `prisma migrate dev --create-only`.
//
// Conventions: tables and columns are snake_case (`@@map` / `@map`), money
// and prices are fixed-precision `numeric`, timestamps are `timestamptz`.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// A tradable instrument, keyed by its exchange ticker.
model Symbol {
  id        Int      @id @default(autoincrement())
  ticker    String   @unique @db.VarChar(16)
  name      String
  /// MIC-style exchange code, e.g. XNAS, XNYS.
  exchange  String   @db.VarChar(16)
  /// Inactive symbols keep their history but are skipped by ingestion.
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  candlesDaily     CandleDaily[]
  corporateActions CorporateAction[]

  @@map("symbols")
}

/// One raw (unadjusted) daily bar. A TimescaleDB hypertable partitioned on
/// `ts`. Adjusted prices are computed at read time from `corporate_actions`.
model CandleDaily {
  symbolId Int      @map("symbol_id")
  /// The session date at 00:00 UTC.
  ts       DateTime @db.Timestamptz(6)
  open     Decimal  @db.Decimal(18, 6)
  high     Decimal  @db.Decimal(18, 6)
  low      Decimal  @db.Decimal(18, 6)
  close    Decimal  @db.Decimal(18, 6)
  volume   BigInt

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  // Hypertable unique keys must include the partition column (`ts`). Leading
  // with symbol_id serves "one symbol over a date range", the main read.
  @@id([symbolId, ts])
  @@map("candles_daily")
}

enum CorporateActionType {
  SPLIT    @map("split")
  DIVIDEND @map("dividend")

  @@map("corporate_action_type")
}

/// A split or cash dividend, effective on its ex-date. Which columns are set
/// depends on `type`; a CHECK constraint in the migration enforces it.
model CorporateAction {
  id         Int                 @id @default(autoincrement())
  symbolId   Int                 @map("symbol_id")
  type       CorporateActionType
  exDate     DateTime            @map("ex_date") @db.Date
  /// Split: `split_from` old shares became `split_to` new ones
  /// (NVDA 2024: from 1, to 10). A reverse split has from > to.
  splitFrom  Decimal?            @map("split_from") @db.Decimal(18, 6)
  splitTo    Decimal?            @map("split_to") @db.Decimal(18, 6)
  /// Dividend: cash paid per share, in the listing currency.
  cashAmount Decimal?            @map("cash_amount") @db.Decimal(18, 6)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  symbol Symbol @relation(fields: [symbolId], references: [id], onDelete: Cascade)

  // Also the natural key the bootstrap CLI upserts on.
  @@unique([symbolId, type, exDate])
  @@map("corporate_actions")
}

/// A person who can sign in. Registration is invite-only until Phase 7 (an
/// env allowlist of emails; see ADR 0006).
model User {
  /// UUIDv7: time-ordered like a serial, but doesn't reveal how many users
  /// exist when it shows up in a token or a URL.
  id           String   @id @default(uuid(7)) @db.Uuid
  /// Stored trimmed and lower-cased; a CHECK constraint in the migration
  /// rejects anything else, so uniqueness is case-insensitive.
  email        String   @unique @db.VarChar(254)
  /// Argon2id in PHC string format (`$argon2id$v=19$m=...`), parameters
  /// included, so they can be raised later without a migration.
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  sessions  Session[]
  auditLogs AuditLog[]

  @@map("users")
}

enum SessionRevokedReason {
  /// The user signed out on this device.
  LOGOUT         @map("logout")
  /// The user chose "log out everywhere".
  LOGOUT_ALL     @map("logout_all")
  /// A rotated refresh token came back: the family is assumed stolen.
  REUSE_DETECTED @map("reuse_detected")

  @@map("session_revoked_reason")
}

/// One signed-in device: a refresh-token family. Every token rotated from
/// the login's first one belongs to the same session, and revoking the
/// session revokes them all (ADR 0006).
model Session {
  id            String                @id @default(uuid(7)) @db.Uuid
  userId        String                @map("user_id") @db.Uuid
  /// Absolute end of the family. Rotation never extends it, so a stolen
  /// family dies on schedule even if it keeps refreshing.
  expiresAt     DateTime              @map("expires_at") @db.Timestamptz(6)
  revokedAt     DateTime?             @map("revoked_at") @db.Timestamptz(6)
  revokedReason SessionRevokedReason? @map("revoked_reason")
  /// Recorded at login, for a future "your devices" list. Not trusted for
  /// any decision.
  userAgent     String?               @map("user_agent") @db.VarChar(512)
  ip            String?               @db.Inet
  createdAt     DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokens RefreshToken[]

  // "Log out everywhere" revokes a user's live sessions.
  @@index([userId])
  @@map("sessions")
}

/// One opaque refresh token. Only its SHA-256 hash is stored: the token is
/// 256 random bits, so a fast hash is enough, and a database leak yields
/// nothing usable.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  tokenHash Bytes     @unique @map("token_hash") @db.ByteA
  /// The token this one was rotated from: null for the login's first token,
  /// and once the parent is pruned.
  parentId  String?   @map("parent_id") @db.Uuid
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  /// Set when the token is exchanged. Presenting it again after the grace
  /// window is reuse, and revokes the session.
  rotatedAt DateTime? @map("rotated_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  session  Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  parent   RefreshToken?  @relation("RefreshTokenRotation", fields: [parentId], references: [id], onDelete: SetNull)
  children RefreshToken[] @relation("RefreshTokenRotation")

  @@index([sessionId])
  @@index([parentId])
  @@map("refresh_tokens")
}

enum AuditAction {
  REGISTER        @map("register")
  LOGIN_SUCCEEDED @map("login_succeeded")
  LOGIN_FAILED    @map("login_failed")
  REFRESH_REUSED  @map("refresh_reused")
  LOGOUT          @map("logout")
  LOGOUT_ALL      @map("logout_all")

  @@map("audit_action")
}

/// Append-only record of security events. The repository only inserts.
model AuditLog {
  id        BigInt      @id @default(autoincrement())
  /// Null when the event has no known user, e.g. a login with an unknown
  /// email. Kept (set null) if the user is ever deleted.
  userId    String?     @map("user_id") @db.Uuid
  action    AuditAction
  ip        String?     @db.Inet
  userAgent String?     @map("user_agent") @db.VarChar(512)
  /// Event-specific details, e.g. the session id. Never a password or token.
  metadata  Json        @default("{}")
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  // A user's history, newest first.
  @@index([userId, createdAt(sort: Desc)])
  @@map("audit_logs")
}
