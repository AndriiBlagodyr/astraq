{
  "description": "The strategy DSL's contract (ADR 0012). StrategyDefinitionSchema in packages/shared and the generated Pydantic model in services/ml must both accept every document under `valid` and refuse every one under `invalid`. An invalid case is `base` (a name under `valid`) with the value at `path` replaced by `value`, or removed when `remove` is true.",
  "valid": {
    "sma crossover": {
      "version": 1,
      "entry": {
        "type": "cross",
        "left": { "type": "sma", "period": 20, "source": "close" },
        "direction": "above",
        "right": { "type": "sma", "period": 50, "source": "close" }
      },
      "exit": {
        "type": "cross",
        "left": { "type": "sma", "period": 20, "source": "close" },
        "direction": "below",
        "right": { "type": "sma", "period": 50, "source": "close" }
      },
      "stopLoss": null,
      "takeProfit": null,
      "sizing": { "type": "percent_of_equity", "percent": "95" }
    },
    "rsi threshold": {
      "version": 1,
      "entry": {
        "type": "compare",
        "left": { "type": "rsi", "period": 14 },
        "operator": "lt",
        "right": { "type": "constant", "value": "30" }
      },
      "exit": {
        "type": "compare",
        "left": { "type": "rsi", "period": 14 },
        "operator": "gt",
        "right": { "type": "constant", "value": "70" }
      },
      "stopLoss": { "percent": "8" },
      "takeProfit": { "percent": "25.5" },
      "sizing": { "type": "fixed_notional", "amount": "2500.00" }
    },
    "breakout": {
      "version": 1,
      "entry": {
        "type": "all",
        "conditions": [
          {
            "type": "compare",
            "left": { "type": "bar", "field": "close" },
            "operator": "gt",
            "right": {
              "type": "bollinger",
              "period": 20,
              "deviations": "2",
              "band": "upper"
            }
          },
          {
            "type": "any",
            "conditions": [
              {
                "type": "compare",
                "left": { "type": "atr", "period": 14 },
                "operator": "gte",
                "right": { "type": "constant", "value": "0.5" }
              },
              {
                "type": "compare",
                "left": { "type": "bar", "field": "volume" },
                "operator": "gt",
                "right": { "type": "constant", "value": "1000000" }
              }
            ]
          }
        ]
      },
      "exit": {
        "type": "cross",
        "left": { "type": "bar", "field": "close" },
        "direction": "below",
        "right": { "type": "ema", "period": 10, "source": "close" }
      },
      "stopLoss": { "percent": "100" },
      "takeProfit": null,
      "sizing": { "type": "percent_of_equity", "percent": "0.5" }
    }
  },
  "invalid": [
    {
      "name": "a version this code doesn't know",
      "base": "sma crossover",
      "path": ["version"],
      "value": 2
    },
    {
      "name": "no version",
