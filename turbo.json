{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "storybook-static/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      // Turborepo's strict env mode hands tasks only the variables it knows
      // about. These are the service settings a developer may override from
      // the shell (README "Environment variables"); dev is never cached, so
      // they pass through without joining a hash.
      "passThroughEnv": [
        "PORT",
        "LOG_LEVEL",
        "DATABASE_URL",
        "REDIS_URL",
        "CORS_ORIGINS",
        "ENVIRONMENT",
        "API_URL",
        "ML_URL"
      ]
    },
    "@astraq/ui#dev": {
      "dependsOn": ["@astraq/ui#build"],
      "cache": false,
      "persistent": true
    },
    "@astraq/shared#dev": {
      "dependsOn": ["@astraq/shared#build"],
      "cache": false,
      "persistent": true
    },
    "@astraq/sdk#dev": {
      "dependsOn": ["@astraq/sdk#build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^build", "^typecheck"]
    },
    "test:unit": {
      "dependsOn": ["^build"],
      "outputs": []
    }
  }
}
